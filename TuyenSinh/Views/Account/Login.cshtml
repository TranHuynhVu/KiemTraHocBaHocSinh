@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - UTE Tuyển Sinh</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin/adminlayout.css" asp-append-version="true" />
</head>
<body class="login-page-body">

    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <h1 class="login-title">Hệ thống Tuyển sinh UTE</h1>
                <p class="login-subtitle">Vui lòng đăng nhập bằng tài khoản Quản trị viên</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @if (!Html.ViewData.ModelState.IsValid)
                {
                    <div class="login-validation-box">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="login-label">Tài khoản Email</label>
                    <div class="login-input-group">
                        <span class="login-input-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input asp-for="Email" class="login-control" placeholder="admin@tuyensinh.edu.vn" autocomplete="username" required />
                    </div>
                    <span asp-validation-for="Email" class="login-validation-msg"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="login-label">Mật khẩu</label>
                    <div class="login-input-group">
                        <span class="login-input-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input asp-for="Password" class="login-control" placeholder="••••••••" autocomplete="current-password" required />
                    </div>
                    <span asp-validation-for="Password" class="login-validation-msg"></span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label text-muted small" for="rememberMe">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    <span>Đăng nhập hệ thống</span>
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                </button>
            </form>
        </div>

        <div class="login-footer">
            <p class="mb-0">&copy; @DateTime.Now.Year Trường Đại học Sư phạm Kỹ thuật - UTE Tuyển Sinh</p>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
