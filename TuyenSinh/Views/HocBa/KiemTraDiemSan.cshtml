@using TuyenSinh.Models
@{
    ViewData["Title"] = "Kiểm tra điểm sàn tuyển sinh";
    ViewData["PageTitle"] = "Kiểm tra điểm sàn tuyển sinh";
    Layout = "_AdminLayout";
    var dsNganh = ViewBag.DanhSachNganh as List<Nganh> ?? new List<Nganh>();
}

<div class="mb-4">
    <h4 class="mb-1 doichieu-page-title">Kiểm tra điểm sàn tuyển sinh</h4>
    <p class="text-muted small mb-0">Hệ thống đối chiếu dữ liệu điểm xét tuyển, tổ hợp môn và điểm sàn môn Toán theo ngành tuyển sinh.</p>
</div>

<div class="card border-0 shadow-sm mb-4 rounded-12 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom-light">
        <h5 class="mb-0 doichieu-card-title">
            <i class="fa-solid fa-list-check text-primary me-2"></i>Nạp dữ liệu kiểm tra điểm sàn
        </h5>
    </div>
    <div class="card-body p-4">
        <form id="diemSanForm" method="post" action="/admin/hoc-ba/thuc-hien-kiem-tra-diem-san" enctype="multipart/form-data">
            
            <!-- Chọn ngành -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark mb-2">
                    <i class="fa-solid fa-graduation-cap text-primary me-1"></i>Chọn ngành kiểm tra:
                </label>
                <select name="maNganh" id="selectMaNganh" class="form-select rounded-8">
                    <option value="">-- Tất cả các ngành trong tệp --</option>
                    @foreach (var n in dsNganh)
                    {
                        <option value="@n.MaNganh">[@n.MaNganh] @n.TenNganh (Điểm sàn: @n.DXT, Điểm sàn Toán: @n.DiemSanToan)</option>
                    }
                </select>
                <div class="form-text text-muted small mt-1">
                    Nếu chọn một ngành cụ thể, hệ thống sẽ đối chiếu dữ liệu trong tệp với ngành này.
                </div>
            </div>

            <!-- Upload File -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold text-dark mb-0">
                        <i class="fa-solid fa-file-excel text-success me-1"></i>Tệp dữ liệu điểm xét tuyển (.xlsx):
                    </label>
                    <a href="/admin/template/download/Mau_KiemTraDiemSan.xlsx" class="btn btn-link btn-sm p-0 text-decoration-none small text-success fw-semibold">
                        <i class="fa-solid fa-download me-1"></i>Tải file mẫu Excel
                    </a>
                </div>
                <div class="custom-dropzone" id="dropZoneDiemSan">
                    <div class="doichieu-upload-icon mb-2">
                        <i class="fa-solid fa-file-excel fs-1 text-success"></i>
                    </div>
                    <p class="small text-muted mb-2">Kéo thả hoặc nhấp vào đây để chọn tệp dữ liệu</p>
                    <span class="badge bg-light text-secondary border">.xlsx</span>
                    
                    <div id="fileDiemSanInfo" class="d-none mt-3">
                        <div class="inline-flex align-items-center gap-2 p-2 px-3 rounded bg-primary-subtle text-primary fw-semibold small">
                            <i class="fa-solid fa-file-excel text-success"></i>
                            <span id="fileDiemSanName"></span>
                            <i class="fa-solid fa-circle-check text-success ms-1"></i>
                        </div>
                    </div>
                </div>
                <input type="file" name="file" id="fileDiemSan" class="file-input-hidden d-none" accept=".xlsx" required />
            </div>

            <div class="text-center mt-4">
                <button type="submit" id="btnThucHienKiemTra" class="btn btn-primary px-4 py-2 fw-bold rounded-8" disabled>
                    <i class="fa-solid fa-magnifying-glass-chart me-2"></i>Thực hiện kiểm tra điểm sàn
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/hocba/kiemtradiemsan.js" asp-append-version="true"></script>
}
