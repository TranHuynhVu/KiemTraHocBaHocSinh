@{
    ViewData["Title"] = "Kiểm tra học bạ";
    ViewData["PageTitle"] = "Kiểm tra logic học bạ thí sinh";
    Layout = "_AdminLayout";
}



<div class="upload-container py-3">
    <!-- Breadcrumb / Header -->
    <div class="mb-4">
        <h4 class="mb-1 page-main-heading">Kiểm tra logic học bạ thí sinh</h4>
        <p class="text-muted small mb-0">Hệ thống đối chiếu dữ liệu điểm số các năm học THPT (Lớp 10, 11, 12) theo tổ hợp môn cấu hình.</p>
    </div>

    <!-- Upload Card -->
    <div class="card custom-card">
        <div class="card-header">
            <h5 class="m-0 upload-heading">
                <i class="fa-solid fa-cloud-arrow-up text-primary me-2"></i>Nạp dữ liệu học bạ tuyển sinh
            </h5>
        </div>
        <div class="card-body">
            <form id="uploadForm" enctype="multipart/form-data">
                <div class="drop-zone-wrapper" id="dropZone">
                    <div class="upload-icon">
                        <i class="fa-solid fa-file-excel"></i>
                    </div>
                    
                    <h5 class="text-dark mb-2 drop-zone-title">Tải tệp tin học bạ lên hệ thống</h5>
                    <p class="text-muted small mb-3">Kéo và thả tệp tin Excel/CSV của bạn vào đây, hoặc click để chọn tệp</p>
                    
                    <!-- Hidden input to make UI cleaner -->
                    <input type="file" id="excelFile" name="file" class="file-input-hidden" accept=".xlsx" required />
                    
                    <div id="selectFileBtnWrapper">
                        <button type="button" class="select-file-btn" id="btnSelectFile">
                            <i class="fa-solid fa-folder-open"></i> Chọn tệp từ máy tính
                        </button>
                    </div>

                    <!-- Selected file name display -->
                    <div id="fileInfoWrapper" class="d-none">
                        <div class="file-info-badge">
                            <i class="fa-solid fa-file-excel flex-shrink-0"></i>
                            <span id="selectedFileName" class="text-truncate-filename">Tên file ở đây</span>
                            <i class="fa-solid fa-circle-check text-success ms-1 flex-shrink-0"></i>
                        </div>
                    </div>

                    <div class="text-muted small mt-4">Hỗ trợ định dạng: <strong>.xlsx</strong> (Tối đa: 20MB)</div>
                </div>

                <div class="text-center mt-4">
                    <button type="button" id="btnUpload" class="btn btn-primary btn-submit-upload" disabled>
                        <i class="fa-solid fa-cloud-arrow-up me-2"></i> Tiếp tục và Xem trước dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hocba/hocbaindex.js" asp-append-version="true"></script>
}
