@model IEnumerable<TuyenSinh.Models.MonHoc>
@{
    ViewData["Title"] = "Quản lý môn học";
    ViewData["PageTitle"] = "Quản lý môn học";
    Layout = "_AdminLayout";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-4 bg-white rounded-4 shadow-sm border">
    <div>
        <h4 class="mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="fa-solid fa-book text-primary fs-4"></i>
            Quản lý môn học
        </h4>
        <p class="text-muted small mb-0">Quản lý danh mục các môn học sử dụng trong hệ thống xét tuyển học bạ.</p>
    </div>
</div>

<div class="row">
    <!-- Form Thêm môn học -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm border-radius">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="mb-0 text-dark">Thêm môn học mới</h5>
            </div>
            <div class="card-body">
                <form asp-controller="MonHoc" asp-action="ThemMonHoc" method="post">
                    <div class="mb-3">
                        <label class="form-label font-weight-500">Tên môn học</label>
                        <input type="text" name="tenMonHoc" class="form-control" placeholder="Ví dụ: Vật lý" required />
                        <div class="form-text text-muted small">Tên hiển thị chính thức của môn học.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-500">Mã môn</label>
                        <input type="text" name="fieldName" class="form-control" placeholder="Ví dụ: VatLy" required />
                        <div class="form-text text-muted small">Từ khóa prefix của môn học trong Excel (vd: VatLyCN -> điền VatLy).</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-2">
                        <i class="fa-solid fa-plus me-1"></i> Thêm môn học
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Danh sách môn học -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm border-radius">
            <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-dark">Danh sách môn học</h5>
                <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count() Môn học</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered w-100">
                        <thead class="table-light text-secondary font-weight-600">
                            <tr>
                                <th class="ps-4 py-3 text-center">ID</th>
                                <th class="py-3 text-center">Tên môn học</th>
                                <th class="py-3 text-center">Mã môn</th>
                                <th class="pe-4 py-3 text-center text-nowrap">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-folder-open fa-2x mb-3 d-block text-secondary opacity-50"></i>
                                        Chưa có môn học nào được tạo.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 font-weight-600 text-muted">@item.Id</td>
                                        <td class="font-weight-600">@item.TenMonHoc</td>
                                        <td>
                                            <code>@item.FieldName</code>
                                        </td>
                                        <td class="pe-4 text-center text-nowrap">
                                            <button type="button" class="btn btn-outline-primary btn-sm me-2 border-radius" 
                                                    data-bs-toggle="modal" data-bs-target="#editModal-@item.Id">
                                                <i class="fa-solid fa-pen-to-square"></i> Sửa
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm border-radius" 
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Modal Sửa môn học -->
                                    <div class="modal fade" id="editModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-light border-0 py-3 px-4">
                                                    <h5 class="modal-title font-weight-700 text-dark">Chỉnh sửa môn học</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-controller="MonHoc" asp-action="SuaMonHoc" method="post">
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="mb-3">
                                                            <label class="form-label font-weight-500">Tên môn học</label>
                                                            <input type="text" name="tenMonHoc" value="@item.TenMonHoc" class="form-control" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-weight-500">Mã môn</label>
                                                            <input type="text" name="fieldName" value="@item.FieldName" class="form-control" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                                                        <button type="button" class="btn btn-secondary btn-sm px-3 py-2 border-radius" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn btn-primary btn-sm px-3 py-2 border-radius">Cập nhật</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Modal Xóa môn học -->
                                    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-light border-0 py-3 px-4">
                                                    <h5 class="modal-title font-weight-700 text-danger">Xác nhận xóa môn học</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-controller="MonHoc" asp-action="XoaMonHoc" method="post">
                                                    <div class="modal-body p-4 text-center">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <i class="fa-solid fa-triangle-exclamation text-warning fa-3x mb-3"></i>
                                                        <p class="mb-1 text-dark">Bạn có chắc chắn muốn xóa môn học này?</p>
                                                        <p class="text-danger small mb-0">Hành động này không thể hoàn tác và có thể ảnh hưởng đến các tổ hợp chứa môn học này!</p>
                                                        <div class="bg-light p-3 rounded-3 mt-3 font-weight-600">
                                                            @item.TenMonHoc (@item.FieldName)
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                                                        <button type="button" class="btn btn-secondary btn-sm px-3 py-2 border-radius" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn btn-danger btn-sm px-3 py-2 border-radius">Xóa</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
